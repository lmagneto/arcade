
:root {
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  color: #e6eef2;
  background: #08121b;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
}

button {
  font-family: inherit;
}

::selection {
  background: #18d5a0;
  color: #071510;
}
