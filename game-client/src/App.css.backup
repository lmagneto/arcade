
#root {
  min-height: 100vh;
}

.game-shell {
  max-width: 1440px;
  margin: 0 auto;
  padding: 28px 38px;
}

.topbar,
.brand,
.connection,
.round-strip,
.round-state,
.flight-heading,
.flight-controls,
.section-heading,
.player-card-top,
.card-footer,
.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topbar {
  padding-bottom: 25px;
  border-bottom: 1px solid #24313b;
}

.brand {
  justify-content: flex-start;
  gap: 12px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 45px;
  height: 45px;
  border-radius: 13px;
  background: #18d5a0;
  color: #071510;
  font-size: 24px;
  font-weight: 900;
}

.brand h1 {
  margin: 0;
  font-size: 19px;
  letter-spacing: 3px;
}

.brand p,
.section-heading p {
  margin: 4px 0 0;
  color: #82929e;
  font-size: 10px;
  letter-spacing: 1.5px;
}

.connection {
  justify-content: flex-start;
  gap: 9px;
  padding: 10px 13px;
  border: 1px solid #2b4144;
  border-radius: 30px;
  color: #91e9c8;
  font-size: 10px;
  letter-spacing: 1px;
}

.status-dot,
.state-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #18d5a0;
}

.round-strip {
  padding: 21px 0;
}

.round-strip > div:first-child {
  display: flex;
  align-items: center;
  gap: 12px;
}

.muted-label,
.flight-heading,
.balance-label {
  color: #82929e;
  font-size: 10px;
  letter-spacing: 1.5px;
}

.round-strip strong {
  font-size: 16px;
}

.round-state {
  justify-content: flex-start;
  gap: 9px;
  color: #a8b8c2;
  font-size: 11px;
  letter-spacing: 1.3px;
}

.state-dot.waiting {
  background: #e8b45d;
}

.state-dot.running {
  background: #18d5a0;
  box-shadow: 0 0 12px #18d5a0;
}

.state-dot.crashed {
  background: #ff6578;
}

.flight-panel {
  position: relative;
  min-height: 390px;
  overflow: hidden;
  padding: 25px 30px;
  border: 1px solid #253b45;
  border-radius: 19px;
  background: #0c1924;
  isolation: isolate;
}

.sky-grid,
.sky-glow {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: -1;
}

.sky-grid {
  background-image:
    linear-gradient(#1b3442 1px, transparent 1px),
    linear-gradient(90deg, #1b3442 1px, transparent 1px);
  background-size: 48px 48px;
  opacity: 0.32;
  mask-image: linear-gradient(to top, black, transparent 95%);
}

.sky-glow {
  background: radial-gradient(ellipse at 70% 90%, #0b5449 0%, transparent 48%);
}

.flight-heading {
  position: relative;
  z-index: 2;
}

.demo-tag,
.slot-count {
  padding: 7px 10px;
  border-radius: 6px;
  background: #16382f;
  color: #5ee5b7;
  font-size: 9px;
  letter-spacing: 1px;
}

.multiplier {
  position: relative;
  z-index: 2;
  margin-top: 22px;
  color: #e9fff7;
  font-size: clamp(50px, 7vw, 88px);
  font-weight: 800;
  letter-spacing: -4px;
  text-align: center;
  text-shadow: 0 0 45px #1bc99b30;
}

.multiplier.crashed {
  color: #ff8291;
}

.flight-path {
  position: absolute;
  right: 20px;
  bottom: 65px;
  left: 20px;
  height: 180px;
  opacity: 0.9;
}

.flight-path svg {
  width: 100%;
  height: 100%;
  overflow: visible;
}

.flight-message {
  position: absolute;
  right: 0;
  bottom: 60px;
  left: 0;
  color: #9babb6;
  font-size: 12px;
  text-align: center;
}

.flight-controls {
  position: absolute;
  right: 0;
  bottom: 20px;
  left: 0;
  justify-content: center;
}

.primary-button,
.secondary-button {
  min-width: 185px;
  padding: 13px 19px;
  border: 0;
  border-radius: 9px;
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.primary-button {
  background: #18d5a0;
  color: #071510;
}

.primary-button:hover {
  background: #55e7bc;
}

.primary-button span {
  margin-left: 12px;
}

.secondary-button {
  border: 1px solid #40515c;
  background: #172733;
  color: #dce9ee;
}

.demo-notice {
  position: absolute;
  right: 0;
  bottom: 3px;
  left: 0;
  color: #607582;
  font-size: 9px;
  text-align: center;
}

.players-section {
  margin-top: 32px;
}

.section-heading {
  margin-bottom: 18px;
}

.section-heading h2 {
  margin: 0;
  font-size: 17px;
}

.section-heading p {
  font-size: 11px;
  letter-spacing: 0;
}

.player-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.player-card {
  min-width: 0;
  padding: 18px;
  border: 1px solid #263943;
  border-radius: 13px;
  background: #0e1c27;
}

.player-card.inactive {
  opacity: 0.53;
}

.player-icon {
  display: grid;
  place-items: center;
  width: 35px;
  height: 35px;
  border-radius: 9px;
  background: #183a35;
  color: #66e9c0;
  font-size: 12px;
  font-weight: 800;
}

.player-status {
  color: #738692;
  font-size: 9px;
  letter-spacing: 1px;
}

.player-status.online {
  color: #56dbb0;
}

.player-card h3 {
  margin: 17px 0 19px;
  font-size: 14px;
}

.balance-label {
  margin-bottom: 8px;
  font-size: 9px;
}

.balance {
  font-size: 26px;
  font-weight: 700;
  letter-spacing: -1px;
}

.balance span {
  color: #8ca29f;
  font-size: 10px;
  letter-spacing: 0;
}

.card-footer {
  gap: 8px;
  margin-top: 20px;
  padding-top: 13px;
  border-top: 1px solid #263943;
  color: #718692;
  font-size: 9px;
}

.card-footer span:last-child {
  text-align: right;
}

.footer {
  gap: 12px;
  margin-top: 30px;
  padding-top: 18px;
  border-top: 1px solid #24313b;
  color: #637783;
  font-size: 9px;
  letter-spacing: 1px;
}

@media (max-width: 900px) {
  .game-shell {
    padding: 20px;
  }

  .player-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 520px) {
  .game-shell {
    padding: 14px;
  }

  .flight-panel {
    min-height: 350px;
    padding: 18px;
  }

  .player-grid {
    grid-template-columns: 1fr;
  }

  .footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

.connection-panel {
  min-height: 300px;
}

.connection-panel h2 {
  margin: 28px 0 8px;
  font-size: 24px;
}

.connect-description {
  max-width: 560px;
  color: #9babb6;
  font-size: 13px;
  line-height: 1.7;
}

.connect-form {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px 14px;
  max-width: 680px;
  margin-top: 24px;
}

.connect-form label {
  grid-column: 1 / -1;
  color: #aebdc6;
  font-size: 11px;
}

.connect-form input {
  min-width: 0;
  padding: 13px;
  border: 1px solid #354b57;
  border-radius: 8px;
  outline: none;
  background: #08121b;
  color: #e6eef2;
}

.connect-form input:focus {
  border-color: #18d5a0;
}

.connect-form .primary-button:disabled {
  cursor: wait;
  opacity: 0.65;
}

.error-message {
  color: #ff8997;
  font-size: 12px;
  line-height: 1.6;
}

.server-warning {
  margin: 16px 0;
}

.server-info {
  color: #718692;
  font-size: 10px;
}

@media (max-width: 600px) {
  .connect-form {
    grid-template-columns: 1fr;
  }

  .connect-form label {
    grid-column: auto;
  }
}

.pairing-code {
  margin: 28px 0 10px;
  padding: 20px 12px;
  border: 1px dashed #376458;
  border-radius: 12px;
  background: #071710;
  color: #70f0c2;
  font-size: clamp(28px, 6vw, 48px);
  font-weight: 800;
  letter-spacing: 7px;
  text-align: center;
  overflow-wrap: anywhere;
}

.countdown {
  margin: 10px 0;
  color: #e8c77e;
  font-size: 13px;
  text-align: center;
}

.waiting-message {
  color: #8edec3;
  font-size: 13px;
  text-align: center;
}

.connection-panel .primary-button {
  display: block;
  margin: 18px auto 0;
}

@media (max-width: 520px) {
  .pairing-code {
    letter-spacing: 3px;
  }
}


